# Database for Better Auth (standard PostgreSQL format)
DATABASE_URL='postgresql://user:password@host/dbname?sslmode=require'

# Better Auth secret (generate a random 32+ char string) — DO NOT use NEXT_PUBLIC_ prefix
BETTER_AUTH_SECRET="your-secret-key-here"

# App URLs (for local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# On Vercel, VERCEL_URL is auto-injected so NEXT_PUBLIC_APP_URL is optional.
# Set BETTER_AUTH_URL only if you use a custom domain:
# BETTER_AUTH_URL=https://your-custom-domain.com
